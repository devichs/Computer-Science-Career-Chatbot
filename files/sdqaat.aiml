<aiml version="2.0">
	<!-- Software Developers, Quality Assurance Analysts, and Testers Path -->
  <category>
    <pattern>Software Developers, Quality Assurance Analysts, and Testers</pattern>
    <template>
        Great choice! 
        Software developers design computer applications or programs. Software quality assurance analysts and testers identify problems with applications or programs and report defects.<br></br>
        To research other careers click the button below.<br></br>
        <link>
            <text>
                Click this link for more information!
                </text>
            <url>https://www.bls.gov/ooh/computer-and-information-technology/software-developers.htm/</url>
        </link>
        <button>
            <text>Back to career choices!</text>
            <postback>START INTERESTS CHECK</postback>
        </button>
        <button>
            <text>End Conversation</text>
            <postback>end</postback>
        </button>
    </template>
  </category>
</aiml>