<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
	<!-- insert your AIML categories here -->
	<!--Getting started with yes or no options-->
	<category>
	    <pattern>*</pattern>
	    <template>
	        Hello There! Welcome to CareerBot where you can find your Computer Science Career!
	        Would you like help deciding on a Computer Science Career?
	        <button>
	            <text>Yes</text>
	            <postback>yes</postback>
            </button>
            <button>
                <text>No</text>
                <postback>no</postback>
            </button>
        </template>
    </category>
    
    <!--No-->
    <category>
        <pattern>no</pattern>
        <template>
            Well, I wish you luck and have a pleasant day!
        </template>
    </category>
    
    <!--Yes-->
    <category>
        <pattern>yes</pattern>
        <template>
            Great!  You won't be disappointed!<br></br>
            Lets check your career interests first!<br></br>
            <button>
                <text>Start Interests Check</text>
                <postback>START INTERESTS CHECK</postback>
            </button>
        </template>
    </category>

    <!--Chat ends-->
    <category>
        <pattern>end</pattern>
        <template>
            Thank you! And good luck in your career!
        </template>
    </category>
</aiml>

